# Copy to .env. Leave secrets blank to generate local credentials on first launch.
APP_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
# SQLite is default. PostgreSQL: install psycopg[binary] and use postgresql+psycopg://...
DATABASE_URL=
OFFLINE_TIMEOUT_SECONDS=45
STALE_TIMEOUT_SECONDS=30
MONITOR_INTERVAL_SECONDS=5
SESSION_COOKIE_SECURE=false
# Number to provision on the FIRST launch only (1..6).
SIM_ROVER_COUNT=4
SIM_API_URL=http://127.0.0.1:5000
SIM_INTERVAL_SECONDS=10
SIM_SEED=42
SIM_ANOMALY_FREQUENCY=0.08
SIM_OBSTACLE_FREQUENCY=0.06
# Optional independent simulator config file. Default instance/simulator.json
SIM_CONFIG=

# Farm assistant (server-side only). Restart after changing these values.
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
DEEPINFRA_STT_MODEL=openai/whisper-large-v3-turbo
DEEPINFRA_TTS_MODEL=ResembleAI/chatterbox-multilingual
# Streaming voice path; server-side only.
DEEPINFRA_VOICE_CHAT_MODEL=Qwen/Qwen3.5-35B-A3B
DEEPINFRA_FAST_TTS_MODEL=inworld-ai/realtime-tts-2
DEEPINFRA_INDIC_TTS_MODEL=inworld-ai/realtime-tts-2
